# --- Required ---------------------------------------------------------------
# Create one at https://gmgn.ai → API (GMGN API Management → Create API Key).
GMGN_API_KEY=

# --- Optional ---------------------------------------------------------------
# Chain to screen: sol / bsc / base / eth
CHAIN=sol

# Seconds between polling cycles (each cycle = 3 trending calls + 1 trenches call)
POLL_INTERVAL_SEC=30

# Dashboard port
PORT=4477

# Scoring thresholds (see README for the methodology)
FLAG_SCORE=70          # score >= FLAG_SCORE for 2 consecutive cycles => FLAGGED
WATCH_SCORE=50         # score >= WATCH_SCORE => WATCH
HOLDER_VEL_TARGET=10   # holders/minute that earns full holder-velocity points
VOL_RATIO_TARGET=3     # 1m volume vs 1h-average multiple that earns full points

# Hard risk gates: size / rug
MIN_LIQUIDITY_USD=10000
MIN_HOLDERS=25
MAX_RUG_RATIO=0.3

# Fresh launches (still on the launchpad curve, or younger than FRESH_MAX_AGE_MIN)
# skip the liquidity floor: a curve reserve or a minutes-old pool is not DEX
# liquidity. They must clear this market-cap floor instead.
MIN_FRESH_MCAP_USD=5000
FRESH_MAX_AGE_MIN=60

# Hard risk gates: bundled / supply-controlled (fractions of total supply).
# A token over ANY of these is blocked outright; an unknown value never blocks.
MAX_TOP10_RATE=0.3          # top-10 holders' share (GMGN calls < 30% "relatively safe")
MAX_BUNDLER_RATE=0.25       # share bought by launch-bundle wallets
MAX_INSIDER_RATE=0.2        # share held by wallets that never bought after open
MAX_DEV_HOLD_RATE=0.1       # dev / team share
MAX_SNIPER_HOLD_RATE=0.4    # share still held by first-blocks snipers
MAX_CONTROLLED_SUPPLY=0.4   # bundlers + insiders + dev combined
REQUIRE_RENOUNCED=1         # block while mint or freeze authority is still live
                            # (set 0 if GMGN reports 0 for every token on your chain)

# Optional: POST a JSON payload to this URL whenever a token gets flagged
# (works with anything that accepts a webhook, e.g. a Discord/Slack relay you run)
ALERT_WEBHOOK_URL=

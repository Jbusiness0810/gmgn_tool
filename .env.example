# --- Required ---------------------------------------------------------------
# Create one at https://gmgn.ai → API (GMGN API Management → Create API Key).
GMGN_API_KEY=

# --- Optional ---------------------------------------------------------------
# Chain to screen: sol / bsc / base / eth
CHAIN=sol

# Seconds between polling cycles (each cycle = 3 trending calls + 1 trenches call)
POLL_INTERVAL_SEC=30

# Dashboard port
PORT=4477

# Scoring thresholds (see README for the methodology)
FLAG_SCORE=70          # score >= FLAG_SCORE for 2 consecutive cycles => FLAGGED
WATCH_SCORE=50         # score >= WATCH_SCORE => WATCH
HOLDER_VEL_TARGET=10   # holders/minute that earns full holder-velocity points
VOL_RATIO_TARGET=3     # 1m volume vs 1h-average multiple that earns full points

# Hard risk gates
MIN_LIQUIDITY_USD=10000
MIN_HOLDERS=25
MAX_RUG_RATIO=0.3
MAX_TOP10_RATE=0.5

# Optional: POST a JSON payload to this URL whenever a token gets flagged
# (works with anything that accepts a webhook, e.g. a Discord/Slack relay you run)
ALERT_WEBHOOK_URL=
